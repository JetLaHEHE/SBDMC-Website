---
import Layout from "../layouts/Layout.astro";
import contact from "../data/contact.json";
---

<Layout title="Contact Us">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute top-20 right-10 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="absolute bottom-10 left-10 h-48 w-48 rounded-full bg-primary-300/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">Get in Touch</div>
      <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">Contact Us</h1>
      <p class="text-lg text-white/70">We'd love to hear from you</p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="mb-2 text-3xl font-bold text-gray-900" data-aos="fade-up">Send Us a Message</h2>
          <p class="mb-8 text-gray-500" data-aos="fade-up" data-aos-delay="50">Fill out the form and we'll get back to you as soon as possible.</p>
          <form class="space-y-5" action={`mailto:${contact.email}`} method="post" enctype="text/plain" data-aos="fade-up" data-aos-delay="100">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-gray-700">Full Name</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-gray-200 px-5 py-3.5 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-100" placeholder="John Doe" />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">Email Address</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-gray-200 px-5 py-3.5 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-100" placeholder="john@company.com" />
            </div>
            <div>
              <label for="company" class="mb-1.5 block text-sm font-medium text-gray-700">Company</label>
              <input type="text" id="company" name="company" class="w-full rounded-xl border border-gray-200 px-5 py-3.5 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-100" placeholder="Company Name" />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-gray-700">Message</label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-gray-200 px-5 py-3.5 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-100" placeholder="Tell us about your inquiry..."></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center text-base">Send Message</button>
          </form>
        </div>

        <div>
          <h2 class="mb-2 text-3xl font-bold text-gray-900" data-aos="fade-up">Contact Information</h2>
          <p class="mb-8 text-gray-500" data-aos="fade-up" data-aos-delay="50">Reach us through any of these channels.</p>

          <div class="space-y-6" data-aos="fade-up" data-aos-delay="100">
            <div class="flex items-start gap-5 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-gray-900">Address</h3>
                {contact.address.split(", ").map((line) => (
                  <p class="text-sm leading-relaxed text-gray-500">{line}</p>
                ))}
              </div>
            </div>

            <div class="flex items-start gap-5 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-gray-900">Phone</h3>
                <p class="text-sm text-gray-500">{contact.phone}</p>
              </div>
            </div>

            <div class="flex items-start gap-5 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-gray-900">Email</h3>
                <p class="text-sm text-gray-500">{contact.email}</p>
              </div>
            </div>

            <div class="flex items-start gap-5 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 font-bold text-gray-900">Office Hours</h3>
                <p class="text-sm text-gray-500">{contact.hours}</p>
              </div>
            </div>
          </div>

          <div class="mt-8" data-aos="fade-up">
            <a href={contact.helpdeskUrl} target="_blank" rel="noopener noreferrer" class="btn-outline w-full justify-center">Visit Our Helpdesk</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative h-96 w-full overflow-hidden">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3850.634297273158!2d120.27188931537355!3d14.830276289659852!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3396716f8c6c1e51%3A0x8c6b5c5b5c5b5c5b!2sSubic%20Bay%20Gateway%20Park!5e0!3m2!1sen!2sph!4v1" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="SBGP Location Map" class="absolute inset-0"></iframe>
  </section>
</Layout>
