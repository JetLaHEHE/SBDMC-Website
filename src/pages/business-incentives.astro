---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Business Incentives">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute top-20 right-10 h-72 w-72 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">Why Locate Here</div>
      <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">Business Incentives</h1>
      <p class="text-lg text-white/70">Unlock exceptional benefits for your business in the Subic Bay Freeport Zone</p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4 inline-flex rounded-full bg-primary-100 px-4 py-1.5 text-xs font-semibold text-primary-600" data-aos="fade-up">Tax Benefits</div>
      <h2 class="mb-10 text-3xl font-bold text-gray-900" data-aos="fade-up" data-aos-delay="50">Tax Incentives</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 p-1 shadow-lg" data-aos="fade-up" data-aos-delay="0">
          <div class="rounded-2xl bg-white p-6">
            <div class="mb-4 text-3xl font-black text-primary-600">4-6</div>
            <h3 class="mb-2 font-bold text-gray-900">Income Tax Holiday</h3>
            <p class="text-sm text-gray-500">Up to 6 years of exemption from corporate income tax for qualified enterprises.</p>
          </div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 p-1 shadow-lg" data-aos="fade-up" data-aos-delay="100">
          <div class="rounded-2xl bg-white p-6">
            <div class="mb-4 text-3xl font-black text-accent-600">5%</div>
            <h3 class="mb-2 font-bold text-gray-900">Preferential Tax Rate</h3>
            <p class="text-sm text-gray-500">After the holiday period, a preferential 5% tax rate on gross income earned.</p>
          </div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 p-1 shadow-lg" data-aos="fade-up" data-aos-delay="200">
          <div class="rounded-2xl bg-white p-6">
            <div class="mb-4 text-3xl font-black text-primary-600">100%</div>
            <h3 class="mb-2 font-bold text-gray-900">Tax Exemption</h3>
            <p class="text-sm text-gray-500">Exemption from local government taxes and fees for registered enterprises.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4 inline-flex rounded-full bg-accent-100 px-4 py-1.5 text-xs font-semibold text-accent-600" data-aos="fade-up">Trade Benefits</div>
      <h2 class="mb-10 text-3xl font-bold text-gray-900" data-aos="fade-up" data-aos-delay="50">Customs & Trade Incentives</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Duty-Free Importation</h3>
          <p class="text-sm text-gray-500">Tax and duty-free importation of capital equipment, raw materials, and supplies for registered enterprises.</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-100 text-accent-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Simplified Customs</h3>
          <p class="text-sm text-gray-500">Streamlined import and export procedures with minimal paperwork and faster processing times.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4 inline-flex rounded-full bg-primary-100 px-4 py-1.5 text-xs font-semibold text-primary-600" data-aos="fade-up">Investment Benefits</div>
      <h2 class="mb-10 text-3xl font-bold text-gray-900" data-aos="fade-up" data-aos-delay="50">Investment Incentives</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm" data-aos="fade-up">
          <div class="mb-4 text-3xl font-black text-primary-600">100%</div>
          <h3 class="mb-1 font-bold text-gray-900">Foreign Ownership</h3>
          <p class="text-sm text-gray-500">Up to 100% foreign ownership allowed in most business activities.</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 text-3xl font-black text-accent-600">Free</div>
          <h3 class="mb-1 font-bold text-gray-900">Currency Controls</h3>
          <p class="text-sm text-gray-500">Free repatriation of profits and investments without currency restrictions.</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-4 text-3xl font-black text-primary-600">Flex</div>
          <h3 class="mb-1 font-bold text-gray-900">Foreign Nationals</h3>
          <p class="text-sm text-gray-500">Flexible rules for employing foreign nationals in supervisory and technical roles.</p>
        </div>
      </div>
      <div class="mt-12 text-center" data-aos="fade-up">
        <p class="mb-6 text-gray-600">For a complete and detailed list of incentives, please contact our team.</p>
        <a href="/contact" class="btn-primary">Contact Our Team</a>
      </div>
    </div>
  </section>
</Layout>
