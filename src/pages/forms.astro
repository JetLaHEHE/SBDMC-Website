---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Downloads">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute bottom-0 left-0 h-64 w-64 -translate-x-1/4 translate-y-1/4 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">Downloads</div>
      <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">Forms & Downloads</h1>
      <p class="text-lg text-white/70">Download forms, brochures, and handy guides</p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Infrastructure Brochure</h3>
          <p class="mb-4 text-sm text-gray-500">Detailed information about SBGP facilities and infrastructure.</p>
          <a href="https://irp.cdn-website.com/33a8ffc6/files/uploaded/INFRASTRUCTURE+%281%29.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Download PDF
          </a>
        </div>

        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Handy Guide</h3>
          <p class="mb-4 text-sm text-gray-500">Quick reference guide for locators and visitors.</p>
          <a href="/handy-guide" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
            View Guide
          </a>
        </div>

        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Customer Survey Form</h3>
          <p class="mb-4 text-sm text-gray-500">Help us improve our services by filling out our online survey.</p>
          <a href="https://docs.google.com/forms/d/e/1FAIpQLScZ0UKsbyfwdQZTMy4mC6AhYkpCKx2NqbjHSpLeHP6kxAOXfQ/viewform" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700">
            Fill Out Form &rarr;
          </a>
        </div>

        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Application Forms</h3>
          <p class="mb-4 text-sm text-gray-500">Download application forms for various SBDMC services.</p>
          <p class="text-sm text-gray-400">Contact our office for the latest forms.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
