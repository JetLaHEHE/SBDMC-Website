---
import Layout from "../layouts/Layout.astro";
import hero from "../data/hero.json";
import news from "../data/news.json";
const stats = hero.stats;
const newsItems = news.items;
---

<Layout title="Home">
  <section class="relative min-h-[90vh] overflow-hidden bg-gradient-to-br from-primary-900 via-primary-600 to-accent-600 bg-[length:200%_200%] pt-24 animate-gradient-x">
    <div class="absolute inset-0 bg-grid"></div>
    <div class="absolute top-20 left-10 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 h-80 w-80 rounded-full bg-primary-300/20 blur-3xl"></div>
    <div class="relative mx-auto flex min-h-[90vh] max-w-6xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8">
      <div data-aos="fade-up" data-aos-delay="0">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium text-white/80 backdrop-blur-sm">
          <span class="flex h-2 w-2 rounded-full bg-accent-400"></span>
          {hero.badge}
        </div>
      </div>
      <h1 data-aos="fade-up" data-aos-delay="100" class="mb-6 text-5xl font-extrabold leading-tight text-white md:text-7xl lg:text-8xl text-balance">
        {hero.headline}
        <span class="gradient-text">{hero.headlineHighlight}</span>
      </h1>
      <p data-aos="fade-up" data-aos-delay="200" class="mb-10 max-w-2xl text-lg text-white/70 md:text-xl">
        {hero.subtitle}
      </p>
      <div data-aos="fade-up" data-aos-delay="300" class="flex flex-wrap justify-center gap-4">
        <a href={hero.ctaPrimary.link} class="btn-white text-base">{hero.ctaPrimary.text}</a>
        <a href={hero.ctaSecondary.link} class="rounded-xl border-2 border-white/30 px-7 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10 hover:-translate-y-0.5">{hero.ctaSecondary.text}</a>
      </div>
    </div>
  </section>

  <section class="relative bg-gradient-to-br from-primary-800 to-primary-900 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-4">
        {stats.map((stat, i) => (
          <div class="text-center" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="mb-2 text-4xl font-bold text-white md:text-5xl">{stat.value}</div>
            <div class="text-sm font-medium text-white/60">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative bg-gray-50 py-24">
    <div class="absolute inset-0 bg-grid-dark"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="section-title">{hero.servicesTitle}</h2>
        <p class="section-subtitle">{hero.servicesSubtitle}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/rental-information" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg shadow-primary-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">Rental Information</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">Explore available spaces for lease within the park.</p>
        </a>

        <a href="/business-services" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg shadow-accent-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">Business Services</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">Comprehensive support for your business operations.</p>
        </a>

        <a href="/job-opportunities" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg shadow-primary-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">Job Opportunities</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">Find career opportunities within the park.</p>
        </a>

        <a href="/forms" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg shadow-accent-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">Forms & Downloads</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">Download forms, brochures, and handy guides.</p>
        </a>

        <a href="/business-incentives" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg shadow-primary-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">Business Incentives</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">Learn about tax breaks and incentives for locators.</p>
        </a>

        <a href="/for-lease" class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute top-0 right-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-primary-100 transition-all group-hover:scale-150"></div>
          <div class="relative mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg shadow-accent-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          </div>
          <h3 class="relative mb-2 text-lg font-bold text-gray-900">For Lease</h3>
          <p class="relative text-sm leading-relaxed text-gray-500">View available properties for lease in the park.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="section-title">{news.title}</h2>
        <p class="section-subtitle">{news.subtitle}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {newsItems.map((item, i) => (
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="group rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 p-1 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay={i * 100}>
            <div class="rounded-2xl bg-white p-6">
              <div class="mb-3 inline-block rounded-lg bg-primary-100 px-3 py-1 text-xs font-semibold text-primary-600">{item.category}</div>
              <h3 class="font-bold text-gray-900 group-hover:text-primary-600">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-500">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-gray-50 py-24">
    <div class="absolute top-0 left-0 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-100/50 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-64 w-64 translate-x-1/2 translate-y-1/2 rounded-full bg-accent-100/50 blur-3xl"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center" data-aos="fade-up">
        <h2 class="section-title">{hero.featuresTitle}</h2>
        <p class="section-subtitle">{hero.featuresSubtitle}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="0">
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900">Strategic Location</h3>
          <p class="leading-relaxed text-gray-500">Situated in the Subic Bay Freeport Zone with direct access to international shipping routes, airport, and expressways.</p>
          <a href="/map" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700 hover:gap-2">View Location <span>&rarr;</span></a>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900">World-Class Infrastructure</h3>
          <p class="leading-relaxed text-gray-500">Reliable power, water, high-speed fiber optic internet, and modern facilities with 24/7 security.</p>
          <a href="/description" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700 hover:gap-2">Learn More <span>&rarr;</span></a>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900">Business Incentives</h3>
          <p class="leading-relaxed text-gray-500">Tax holidays, duty-free imports, 100% foreign ownership allowed, and streamlined registration processes.</p>
          <a href="/business-incentives" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 transition-all hover:text-primary-700 hover:gap-2">View Incentives <span>&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-primary-800 to-primary-900 py-24">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-6 text-4xl font-bold text-white md:text-5xl" data-aos="fade-up">{hero.ctaTitle}</h2>
      <p class="mb-10 text-lg text-white/60" data-aos="fade-up" data-aos-delay="100">{hero.ctaSubtitle}</p>
      <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
        <a href="/contact" class="btn-white text-base">{hero.ctaButton}</a>
        <a href="/business-incentives" class="rounded-xl border-2 border-white/30 px-7 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10 hover:-translate-y-0.5">View Incentives</a>
      </div>
    </div>
  </section>
</Layout>
