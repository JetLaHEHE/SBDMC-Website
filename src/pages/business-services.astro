---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Business Services">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">Services</div>
      <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">Business Services</h1>
      <p class="text-lg text-white/70">Comprehensive support for your business operations</p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">Registration Assistance</h3>
          <p class="text-sm text-gray-500">Help with business registration, permits, and licensing requirements with SBMA and other agencies.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="50">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-accent-100 text-accent-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">Utility Connection</h3>
          <p class="text-sm text-gray-500">Assistance with connection to power, water, and telecommunications services within the park.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-red-100 text-red-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">Security Services</h3>
          <p class="text-sm text-gray-500">24/7 security monitoring, access control, and patrol services for the safety of your business.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-green-100 text-green-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">Maintenance Support</h3>
          <p class="text-sm text-gray-500">Regular maintenance of common areas, roads, and park facilities for a pleasant working environment.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="50">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-blue-100 text-blue-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">E-Billing</h3>
          <p class="mb-3 text-sm text-gray-500">Convenient online billing and payment system for your monthly statements.</p>
          <a href="https://eipp.unionbankph.com/EIPPHUB" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700">Access Portal &rarr;</a>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm transition-all hover:shadow-xl hover:-translate-y-1" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-purple-100 text-purple-600">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-gray-900">Helpdesk Support</h3>
          <p class="mb-3 text-sm text-gray-500">Dedicated helpdesk for locator concerns, inquiries, and support requests.</p>
          <a href="https://sbdmcinc.freshdesk.com/support/home" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700">Visit Helpdesk &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
