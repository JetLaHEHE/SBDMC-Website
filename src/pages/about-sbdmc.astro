---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About SBDMC">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute top-0 right-0 h-96 w-96 translate-x-1/3 -translate-y-1/3 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div data-aos="fade-up">
        <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">About Us</div>
        <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">&nbsp;SBDMC, Inc.</h1>
        <p class="text-lg text-white/70">Your trusted partner in the Subic Bay Freeport Zone</p>
      </div>
    </div>
  </section>

  <section class="relative bg-gray-50 py-24">
    <div class="absolute inset-0 bg-grid-dark"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
        <p class="text-lg leading-relaxed text-gray-600">
          SBDMC, Inc. is the developer and operator of the Subic Bay Gateway Park (SBGP), a premier industrial park located within the Subic Bay Freeport Zone (SBFZ) in Zambales, Philippines. The company is committed to providing world-class infrastructure and services to business locators in the park.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl bg-gradient-to-br from-primary-500 to-primary-700 p-1 shadow-lg" data-aos="fade-up" data-aos-delay="0">
          <div class="rounded-2xl bg-white p-8">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white shadow-lg">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="mb-3 text-2xl font-bold text-gray-900">Mission</h3>
            <p class="leading-relaxed text-gray-600">To develop and maintain a world-class industrial park that provides a competitive, sustainable, and business-friendly environment for locators, while contributing to the economic growth of the Subic Bay Freeport Zone and the Philippines.</p>
          </div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-accent-500 to-accent-700 p-1 shadow-lg" data-aos="fade-up" data-aos-delay="100">
          <div class="rounded-2xl bg-white p-8">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            </div>
            <h3 class="mb-3 text-2xl font-bold text-gray-900">Vision</h3>
            <p class="leading-relaxed text-gray-600">To be the preferred industrial park of choice in the Asia-Pacific region, known for excellence in infrastructure, service, and environmental stewardship.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-primary-800 to-primary-900 py-24">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-10 backdrop-blur-sm" data-aos="fade-up">
        <div class="mb-4 inline-flex rounded-full bg-accent-500/20 px-4 py-1.5 text-xs font-semibold text-accent-300">Certification</div>
        <h2 class="mb-4 text-3xl font-bold text-white">ISO Certified</h2>
        <p class="mb-2 text-5xl font-bold text-accent-400">PH15/1221</p>
        <p class="text-white/60">Demonstrating our commitment to quality management systems and continuous improvement</p>
      </div>
    </div>
  </section>
</Layout>
