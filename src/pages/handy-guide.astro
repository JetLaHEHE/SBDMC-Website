---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Handy Guide">
  <section class="page-header">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-aos="fade-up">
      <div class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/70 backdrop-blur-sm">Reference</div>
      <h1 class="mb-4 text-5xl font-extrabold md:text-6xl">Handy Guide</h1>
      <p class="text-lg text-white/70">Quick reference for locators and visitors</p>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 rounded-2xl border-2 border-red-200 bg-red-50 p-7" data-aos="fade-up">
        <div class="mb-4 inline-flex rounded-full bg-red-200 px-4 py-1.5 text-xs font-bold text-red-700 uppercase tracking-wider">Emergency</div>
        <h2 class="mb-4 text-2xl font-bold text-gray-900">Emergency Contacts</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl bg-white p-4 shadow-sm">
            <div class="text-lg font-bold text-red-600">911</div>
            <div class="text-sm text-gray-500">Emergency Hotline</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm">
            <div class="text-lg font-bold text-gray-900">(047) 252-3456</div>
            <div class="text-sm text-gray-500">SBDMC Office</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm">
            <div class="text-lg font-bold text-gray-900">(047) 252-4000</div>
            <div class="text-sm text-gray-500">SBMA Main</div>
          </div>
          <div class="rounded-xl bg-white p-4 shadow-sm">
            <div class="text-lg font-bold text-gray-900">117</div>
            <div class="text-sm text-gray-500">Police</div>
          </div>
        </div>
      </div>

      <div class="mb-10 grid gap-6 md:grid-cols-2" data-aos="fade-up">
        <div class="rounded-2xl border border-gray-100 bg-white p-7 shadow-sm">
          <h3 class="mb-4 text-lg font-bold text-gray-900">Important Numbers</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-gray-100 pb-2">
              <span class="text-sm text-gray-600">Police</span>
              <span class="font-bold text-gray-900">117</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-100 pb-2">
              <span class="text-sm text-gray-600">Fire</span>
              <span class="font-bold text-gray-900">160</span>
            </div>
            <div class="flex items-center justify-between border-b border-gray-100 pb-2">
              <span class="text-sm text-gray-600">Medical</span>
              <span class="font-bold text-gray-900">143</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">SBDMC Office</span>
              <span class="font-bold text-gray-900">(047) 252-3456</span>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-7 shadow-sm">
          <h3 class="mb-4 text-lg font-bold text-gray-900">Office Hours</h3>
          <p class="mb-3 text-sm text-gray-600">SBDMC, Inc. office is open:</p>
          <div class="flex items-center justify-between rounded-xl bg-gray-50 p-3">
            <span class="text-sm font-medium text-gray-700">Monday - Friday</span>
            <span class="text-sm text-gray-600">8:00 AM - 5:00 PM</span>
          </div>
          <p class="mt-2 text-xs text-gray-400">Closed on weekends and public holidays.</p>
        </div>
      </div>

      <div class="mb-10 rounded-2xl border border-gray-100 bg-white p-7 shadow-sm" data-aos="fade-up">
        <h3 class="mb-4 text-lg font-bold text-gray-900">Park Rules</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="flex items-start gap-3 rounded-xl bg-gray-50 p-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-sm text-gray-600">All vehicles must register at the entrance</span>
          </div>
          <div class="flex items-start gap-3 rounded-xl bg-gray-50 p-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-sm text-gray-600">Speed limit: 30 km/h within the park</span>
          </div>
          <div class="flex items-start gap-3 rounded-xl bg-gray-50 p-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-sm text-gray-600">Proper waste disposal is required</span>
          </div>
          <div class="flex items-start gap-3 rounded-xl bg-gray-50 p-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-sm text-gray-600">No hazardous materials without prior approval</span>
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 p-7 text-white shadow-lg" data-aos="fade-up">
        <h3 class="mb-3 text-lg font-bold">Useful Links</h3>
        <div class="flex flex-wrap gap-3">
          <a href="https://sbdmcinc.freshdesk.com/support/home" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-white/20 px-5 py-2.5 text-sm font-medium backdrop-blur-sm transition-all hover:bg-white/30">SBDMC Helpdesk</a>
          <a href="https://eipp.unionbankph.com/EIPPHUB" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-white/20 px-5 py-2.5 text-sm font-medium backdrop-blur-sm transition-all hover:bg-white/30">E-Billing Portal</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
