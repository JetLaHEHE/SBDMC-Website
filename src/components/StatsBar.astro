---
interface Props {
  value: string;
  label: string;
  icon?: string;
}
const { value, label } = Astro.props;
---

<div class="text-center" data-aos="fade-up">
  <div class="mb-1 text-4xl font-bold text-white md:text-5xl">{value}</div>
  <div class="text-sm font-medium text-white/70">{label}</div>
</div>
