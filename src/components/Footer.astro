---
import footer from "../data/footer.json";
import contact from "../data/contact.json";
const quickLinks = footer.quickLinks;
const services = footer.services;
---

<footer class="relative bg-gray-950 text-gray-400">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="border-b border-white/5 py-12">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <div>
          <h3 class="text-xl font-bold text-white">Stay Updated</h3>
          <p class="mt-1 text-sm text-gray-500">Get the latest news and updates from SBGP.</p>
        </div>
        <form class="flex w-full max-w-md gap-3" onsubmit="event.preventDefault(); alert('Newsletter feature coming soon!')">
          <input type="email" placeholder="Enter your email" class="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm text-white placeholder-gray-500 backdrop-blur-sm focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" />
          <button type="submit" class="shrink-0 rounded-xl bg-accent-600 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-accent-500 hover:-translate-y-0.5">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="mb-4 flex items-center gap-2">
          <img src="/images/logo.png" alt="SBDMC" class="h-8 w-auto" />
        </div>
        <p class="mb-4 text-sm leading-relaxed text-gray-500">
          Subic Bay Gateway Park — a premier business and industrial park in the Subic Bay Freeport Zone, Philippines.
        </p>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <p class="text-xs text-gray-500">
            <span class="font-semibold text-accent-400">ISO Certified</span><br />
            Certification No.: PH15/1221
          </p>
        </div>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">Quick Links</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm transition-all hover:text-white hover:translate-x-0.5 inline-block">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">Services</h4>
        <ul class="space-y-3">
          {services.map((link) => (
            <li>
              <a href={link.href} class="text-sm transition-all hover:text-white hover:translate-x-0.5 inline-block">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-xs font-semibold tracking-wider text-gray-300 uppercase">Contact</h4>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 text-gray-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <span class="text-gray-500">{contact.address.split(", ").map((l, li, arr) => <>{l}{li < arr.length - 1 && <br />}</>)}</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 text-gray-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <span class="text-gray-500">{contact.phone}</span>
          </li>
          <li class="flex items-center gap-3">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 text-gray-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <span class="text-gray-500">{contact.email}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row sm:px-6 lg:px-8">
      <p class="text-sm text-gray-600">&copy; {new Date().getFullYear()} SBDMC. All rights reserved.</p>
      <div class="flex gap-3">
        <a href={contact.facebookUrl} target="_blank" rel="noopener noreferrer" class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/5 text-gray-500 transition-all hover:bg-accent-600 hover:text-white" aria-label="Facebook">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
